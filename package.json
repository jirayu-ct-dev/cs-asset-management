{
  "name": "cs-asset-management",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check": "prisma validate",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "postinstall": "nuxt prepare && prisma generate"
  },
  "dependencies": {
    "@adonisjs/hash": "9.1.1",
    "@fontsource-variable/noto-sans-thai": "5.3.0",
    "@nuxt/ui": "4.10.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "csv-parse": "^6.1.0",
    "exceljs": "^4.4.0",
    "nuxt": "4.5.2",
    "nuxt-auth-utils": "0.5.30",
    "pg": "^8.16.3",
    "playwright-core": "1.62.1",
    "qrcode": "^1.5.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/test-utils": "^3.20.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.1",
    "happy-dom": "^20.0.10",
    "prisma": "7.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vue-tsc": "3.3.10",
    "vitest": "^4.0.8"
  }
}
