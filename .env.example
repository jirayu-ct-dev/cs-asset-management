DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cs_asset_management
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters
NUXT_SESSION_COOKIE_SECURE=false
NUXT_PUBLIC_APP_BASE_URL=http://localhost:3000
NUXT_UPLOAD_DIR=./storage/uploads
NUXT_MAX_UPLOAD_SIZE=10485760
NUXT_TRUSTED_PROXY=false
ADMIN_EMAIL=admin@example.test
ADMIN_NAME=ผู้ดูแลระบบทดสอบ
ADMIN_PASSWORD=local-admin-password-1234
BACKUP_REPLICA_PATH=/mnt/off-machine/cs-asset-management
BACKUP_DAILY_RETENTION=7
BACKUP_WEEKLY_RETENTION=4
BACKUP_INTERVAL_SECONDS=86400
BACKUP_HEALTH_MAX_MINUTES=1500
TZ=Asia/Bangkok
